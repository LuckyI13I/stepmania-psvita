# bump-vita-build.cmake — increments the Vita build counter on every build.
# Run in CMake script mode:
#   cmake -DVITA_BUILD_COUNTER=<path to build-number.txt>
#          -DVITA_BUILD_HEADER=<path to generated vita_build_number.h>
#          -P bump-vita-build.cmake
# The custom target `vita_build_number` (see src/CMakeData-vita.cmake) has no
# outputs, so it re-runs on every `ninja` invocation and StepMania depends on
# it, guaranteeing the header is fresh before compiling ArchHooks_Vita.cpp.
if(NOT DEFINED VITA_BUILD_COUNTER OR NOT DEFINED VITA_BUILD_HEADER)
  message(FATAL_ERROR "VITA_BUILD_COUNTER and VITA_BUILD_HEADER must be set")
endif()

set(_num 0)
if(EXISTS "${VITA_BUILD_COUNTER}")
  file(READ "${VITA_BUILD_COUNTER}" _content)
  string(STRIP "${_content}" _content)
  if(_content MATCHES "^[0-9]+$")
    set(_num ${_content})
  endif()
endif()

math(EXPR _num "${_num} + 1")
file(WRITE "${VITA_BUILD_COUNTER}" "${_num}\n")

string(TIMESTAMP _date "%Y-%m-%d" UTC)
string(TIMESTAMP _time "%H:%M:%S" UTC)
file(WRITE "${VITA_BUILD_HEADER}"
  "// Auto-generated by Build-Vita/bump-vita-build.cmake — do not edit.\n"
  "#ifndef VITA_BUILD_NUMBER_H\n"
  "#define VITA_BUILD_NUMBER_H\n"
  "#define VITA_BUILD_NUMBER ${_num}\n"
  "#define VITA_BUILD_DATE \"${_date}\"\n"
  "#define VITA_BUILD_TIME \"${_time}\"\n"
  "#endif\n")
message(STATUS "Vita build number: ${_num}")
